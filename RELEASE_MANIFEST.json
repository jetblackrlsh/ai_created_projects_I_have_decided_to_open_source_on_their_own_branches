{
  "project": "superpower-world-sim",
  "version": "4.7",
  "release_date": "2026-11-10",
  "provenance": "Owner-approved original extensions: nonlethal traced duels/tournaments, configured rivals and tracked main characters, broad scenario customization and 19 measurable behavior-driving goals. Original 53-power world retained. Synthetic examples only; no private history imported or reconstruction claim. Adds selectable public-rank or nonlethal-tournament leadership with actual policy effects and saved succession evidence. Adds independent per-power XP/mastery/rust with explicit legacy preservation, best-held ranking, named goals and individual arena potency. Adds owner-requested opt-in strategic war/civil-war system with faction alliances, territory fronts, resource attrition, mastery-dependent champion support, capture objectives and ceasefires. Supports64-power repertoires and nine original bounded themed abilities, with synthetic multi-power examples. Fixes checkpoint-boundary initialization and preserves alias mastery. Adds original opt-in seeded world-threat campaigns, continuous team combat, population conservation, detection/rescue and full-run records. Adds opt-in truthful individualized recruitment, original-allegiance traces, threat coalition continuation and matched refusal controls. Adds character-owned social stats, goal-driven annual relations and finite tactical diplomacy with actual coalition changes.",
  "verification": {
    "unit_integration_tests": 234,
    "war_batch_worlds": 10,
    "war_batch_years_per_world": 30,
    "seeded_resume": "exact tested in all four individual modes with warfare",
    "large_build_batch_worlds": 10,
    "large_build_years_per_world": 30,
    "large_build_duels": 20,
    "large_build_tournaments": 10,
    "world_threat_runs": 100,
    "no_hero_control_runs": 100,
    "solo_comparison_runs": 200,
    "recruitment_runs": 100,
    "refusal_control_runs": 100,
    "social_tactical_matched_runs": 600,
    "social_annual_demo_worlds": 10
  },
  "manifest_excludes_itself": true,
  "excluded": [
    "Private Drive URLs/account metadata",
    "Original ZIP and private histories/transcripts",
    "Generated simulation outputs, snapshots and validation logs",
