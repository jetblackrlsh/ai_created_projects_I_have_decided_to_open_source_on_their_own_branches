{
  "project": "superpower-world-sim",
  "version": "4.4",
  "release_date": "2026-11-10",
  "provenance": "Owner-approved original extensions: nonlethal traced duels/tournaments, configured rivals and tracked main characters, broad scenario customization and 19 measurable behavior-driving goals. Original 53-power world retained. Synthetic examples only; no private history imported or reconstruction claim. Adds selectable public-rank or nonlethal-tournament leadership with actual policy effects and saved succession evidence. Adds independent per-power XP/mastery/rust with explicit legacy preservation, best-held ranking, named goals and individual arena potency. Adds owner-requested opt-in strategic war/civil-war system with faction alliances, territory fronts, resource attrition, mastery-dependent champion support, capture objectives and ceasefires. Supports64-power repertoires and nine original bounded themed abilities, with synthetic multi-power examples. Fixes checkpoint-boundary initialization and preserves alias mastery.",
  "verification": {
    "unit_integration_tests": 149,
    "war_batch_worlds": 10,
    "war_batch_years_per_world": 30,
    "seeded_resume": "exact tested in all four individual modes with warfare",
    "large_build_batch_worlds": 10,
    "large_build_years_per_world": 30,
    "large_build_duels": 20,
    "large_build_tournaments": 10
  },
  "manifest_excludes_itself": true,
  "excluded": [
    "Private Drive URLs/account metadata",
