  "cases": [
    {
      "id": "check-yes",
      "steps": [
        {
          "id": "completion",
          "request": {
            "prompt": [
              1,
              271,
              273,
              281,
              259
            ],
            "temperature": 0,
            "return_tokens": true,
            "n_predict": 6,
            "cache_prompt": false
          },
          "assert": [
            {
              "path": "/tokens/0",
              "op": "one_of",
              "value": [
                570,
                579
              ]
            },
            {
              "path": "/tokens/3",
              "op": "eq",
              "value": 2
            },
            {
              "path": "/tokens/4",
              "op": "missing"
            }
          ]
        }
