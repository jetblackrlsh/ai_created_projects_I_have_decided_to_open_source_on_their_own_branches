              "path": "/event",
              "op": "eq",
              "value": "pursuit-obtain"
            },
            {
              "path": "/world/pursuit/stage",
              "op": "eq",
              "value": "held"
            }
          ]
        },
        {
          "id": "use",
          "request": {
            "message": "I use the bronze bell.",
            "state": {
              "$ref": "/previous/world"
            }
          },
          "assert": [
            {
              "path": "/event",
              "op": "eq",
              "value": "pursuit-use"
            },
            {
              "path": "/world/pursuit/stage",
              "op": "eq",
              "value": "used"
            }
          ]
        }
      ]
    },
