    {
      "id": "duel-with-a-clear-ending",
      "group": "encounter",
      "steps": [
        {
          "id": "opening",
          "request": {
            "premise": "At a training hall with Pip, I am about to enter a fighting arena against Rowan."
          },
          "assert": [
            {
              "path": "/world/family",
              "op": "eq",
              "value": "arena"
            },
            {
              "path": "/reply",
              "op": "not_regex",
